// Grafana Alloy: 로그 수집기. 모은 로그를 Loki 로 보낸다.
//  1) 이 compose 프로젝트의 모든 컨테이너 stdout/stderr (백엔드, 프론트, MySQL)
//  2) MySQL 슬로우 쿼리 로그 파일 (mysql-data 볼륨의 slow.log)

// ---------- 1) 컨테이너 로그 ----------
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // 컨테이너 이름(/m2m-backend → m2m-backend)을 container 라벨로
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  // docker compose 서비스 이름(backend, mysql ...)을 service 라벨로
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.containers.output
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.write.local.receiver]
}

// ---------- 2) MySQL 슬로우 쿼리 로그 ----------
local.file_match "mysql_slow" {
  path_targets = [{"__path__" = "/mysql-data/slow.log", "job" = "mysql-slow", "service" = "mysql"}]
}

loki.source.file "mysql_slow" {
  targets    = local.file_match.mysql_slow.targets
  forward_to = [loki.process.mysql_slow.receiver]
}

// 슬로우 로그는 "# Time:" 으로 시작하는 여러 줄이 한 건이므로 묶어서 보낸다
loki.process "mysql_slow" {
  stage.multiline {
    firstline     = "^# Time:"
    max_wait_time = "3s"
  }
  forward_to = [loki.write.local.receiver]
}

// ---------- Loki 로 전송 ----------
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
