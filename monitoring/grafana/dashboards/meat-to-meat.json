        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "hikaricp_connections_pending{application=\"meat-to-meat-backend\"}",
          "legendFormat": "커넥션을 기다리는 요청",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "hikaricp_connections_max{application=\"meat-to-meat-backend\"}",
          "legendFormat": "최대",
          "refId": "D"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "초당 SQL 실행 수",
      "description": "Hibernate 가 DB 로 보낸 SQL 문 수(초당)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
