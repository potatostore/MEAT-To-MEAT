      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "요청 1건당 SQL 수 (N+1 지표)",
      "description": "API 하나를 처리하는 데 평균 몇 개의 SQL 이 나가는지. N+1 문제가 있으면 크게 올라간다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(hibernate_statements_total{application=\"meat-to-meat-backend\", status=\"prepared\"}[1m])) / sum(rate(http_server_requests_seconds_count{application=\"meat-to-meat-backend\", uri!~\"/actuator.*\"}[1m]))",
          "legendFormat": "SQL / 요청",
          "refId": "A"
        }
      ],
      "id": 8
    },
