      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "hikaricp_connections_active{application=\"meat-to-meat-backend\"}",
          "legendFormat": "사용 중",
          "refId": "A"
