      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(hibernate_statements_total{application=\"meat-to-meat-backend\", status=\"prepared\"}[1m]))",
          "legendFormat": "SQL/s",
          "refId": "A"
